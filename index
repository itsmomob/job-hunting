        // ===================================================================
        //  PERSISTENCE
        // ===================================================================
        function saveState() {
            try {
                localStorage.setItem(STATE_KEY, JSON.stringify(state));
            } catch (e) { /* ignore */ }
        }

        function loadState() {
            try {
                const raw = localStorage.getItem(STATE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    // Ensure all fields exist
                    if (parsed.profile && parsed.history !== undefined) {
                        state = parsed;
                        return true;
                    }
                }
            } catch (e) { /* ignore */ }
            return false;
        }

        function resetToDefaults() {
            state = JSON.parse(JSON.stringify(defaultState));
            saveState();
        }

        // ===================================================================
        //  RENDER: PROFILE
        // ===================================================================
        function renderProfile() {
            const p = state.profile;
            profileName.value = p.name || '';
            profileTitle.value = p.title || '';
            profileSummary.value = p.summary || '';
            profileExperience.value = (p.experience || []).join('\n');
            profileEducation.value = (p.education || []).join('\n');

            renderTags(skillsContainer, p.skills || [], 'skill');
            renderTags(toolsContainer, p.tools || [], 'tool');
        }

        function renderTags(container, items, type) {
            container.innerHTML = items.map((item, idx) => `
                <span class="tag">
                    ${escapeHtml(item)}
                    <button class="remove-tag" data-type="${type}" data-index="${idx}">&times;</button>
                </span>
            `).join('');

            container.querySelectorAll('.remove-tag').forEach((btn) => {
                btn.addEventListener('click', (e) => {
                    const t = btn.dataset.type;
                    const idx = parseInt(btn.dataset.index);
                    if (t === 'skill') state.profile.skills.splice(idx, 1);
                    else if (t === 'tool') state.profile.tools.splice(idx, 1);
                    saveState();
                    renderProfile();
                    showToast(`${t} removed`, 'fa-minus-circle');
                });
            });
        }

        function collectProfileFromUI() {
            state.profile.name = profileName.value.trim();
            state.profile.title = profileTitle.value.trim();
            state.profile.summary = profileSummary.value.trim();
            state.profile.experience = profileExperience.value.split('\n').filter(s => s.trim());
            state.profile.education = profileEducation.value.split('\n').filter(s => s.trim());
            // skills and tools are managed via add/remove
            saveState();
        }

        // ===================================================================
        //  MATCHING ENGINE
        // ===================================================================
        function extractKeywords(text) {
            const words = text.toLowerCase()
                .replace(/[^a-z0-9\s#+.]/g, ' ')
                .split(/\s+/)
                .filter(w => w.length > 1);
            const stopWords = new Set(['the', 'and', 'for', 'with', 'that', 'this', 'from', 'have', 'are', 'was', 'were',
                'will', 'your', 'you', 'our', 'their', 'they', 'can', 'has', 'had', 'been', 'not', 'but', 'what', 'all',
                'when', 'who', 'which', 'about', 'such', 'would', 'should', 'could', 'may', 'might', 'etc', 'etc.'
            ]);
            return words.filter(w => !stopWords.has(w));
        }

        function matchLists(userList, jobText, threshold = 0.6) {
            const jobWords = extractKeywords(jobText);
            const matched = [];
            const missing = [];

            for (const item of userList) {
                const itemLower = item.toLowerCase();
                let found = false;
                for (const word of jobWords) {
                    if (word.includes(itemLower) || itemLower.includes(word)) {
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    const parts = itemLower.split(/\s+/);
                    let partMatch = 0;
                    for (const part of parts) {
                        if (part.length < 2) continue;
                        for (const word of jobWords) {
                            if (word.includes(part) || part.includes(word)) {
                                partMatch++;
                                break;
                            }
                        }
                    }
                    if (parts.length > 0 && (partMatch / parts.length) >= threshold) {
                        found = true;
                    }
                }
                if (found) matched.push(item);
                else missing.push(item);
            }

            const userSet = new Set(userList.map(s => s.toLowerCase()));
            const extraJobSkills = [];
            for (const word of jobWords) {
                if (word.length > 2 && !userSet.has(word)) {
                    extraJobSkills.push(word);
                }
            }

            return { matched, missing, extraJobSkills };
        }

        function analyzeMatch(jobText) {
            const p = state.profile;
            const allSkills = [...(p.skills || []), ...(p.tools || [])];

            const skillResult = matchLists(p.skills || [], jobText);
            const toolResult = matchLists(p.tools || [], jobText);

            const expLines = p.experience || [];
            const jobWords = extractKeywords(jobText);
            let expMatchCount = 0;
            for (const line of expLines) {
                const lineLower = line.toLowerCase();
                for (const word of jobWords) {
                    if (lineLower.includes(word)) {
                        expMatchCount++;
                        break;
                    }
                }
            }
            const expFit = expLines.length > 0 ? Math.round((expMatchCount / expLines.length) * 100) : 0;

            const totalSkills = allSkills.length;
            const matchedSkillsCount = skillResult.matched.length + toolResult.matched.length;
            const skillScore = totalSkills > 0 ? Math.round((matchedSkillsCount / totalSkills) * 100) : 0;
            const overall = Math.round((skillScore * 0.6) + (expFit * 0.4));

            return {
                skillResult,
                toolResult,
                expFit,
                skillScore,
                overall,
                matchedSkillsCount,
                totalSkills,
                jobWords,
                expLines,
            };
        }

        // ===================================================================
        //  COVER LETTER GENERATOR (personalized for Monica)
        // ===================================================================
        function generateCoverLetter(jobText, matchResult) {
            const p = state.profile;
            const name = p.name || 'Monica Bernasconi';
            const title = p.title || 'Intercultural Communication Specialist';
            const summary = p.summary || 'Passionate about international communication and brand strategy.';

            const matchedSkillsList = [...matchResult.skillResult.matched, ...matchResult.toolResult.matched];
            const missingSkillsList = [...matchResult.skillResult.missing, ...matchResult.toolResult.missing];

            const topSkills = matchedSkillsList.slice(0, 6).join(', ') || 'various relevant skills';
            const expHighlights = matchResult.expLines.slice(0, 3).map(e => `• ${e}`).join('\n') || '• Extensive experience in international communication and project management.';

            // Extract job title
            let jobTitle = 'the position';
            const titleMatch = jobText.match(/(?:title|position|role):\s*([^\n.]+)/i);
            if (titleMatch) jobTitle = titleMatch[1].trim();
            else {
                const firstLine = jobText.split('\n').find(l => l.trim().length > 10);
                if (firstLine) jobTitle = firstLine.trim().slice(0, 60);
            }

            const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            // Monica's unique philosophy and background
            let letter = `[${date}]\n\n`;
            letter += `Dear Hiring Team,\n\n`;
            letter +=
                `I am writing to express my strong interest in the ${jobTitle} role. As a ${title} with a deep passion for cross-cultural communication and strategic brand storytelling, I believe my diverse international experience and creative problem-solving approach align perfectly with your needs.\n\n`;
            letter += `${summary}\n\n`;
            letter += `My background spans institutional communication (European Parliament), community management (Seoul), and freelance brand strategy for clients across Italy and beyond. I thrive at the intersection of language, culture, and digital innovation—I don't just execute; I think strategically and build systems that are clear, human, and scalable.\n\n`;
            letter += `Key qualifications include:\n${expHighlights}\n\n`;
            letter += `My technical toolkit covers ${topSkills}`;
            if (missingSkillsList.length > 0) {
                letter +=
                    `, and I am actively expanding my expertise in ${missingSkillsList.slice(0, 3).join(', ')} to stay ahead in the field.`;
            } else {
                letter += `. I am confident that my skills directly match your requirements.`;
            }
            letter += `\n\nI am particularly drawn to opportunities that challenge me intellectually and allow me to work in truly international, collaborative environments. I value mentorship and am eager to contribute to a team that shares a commitment to excellence and innovation.\n\n`;
            letter += `Thank you for considering my application. I would welcome the opportunity to discuss how I can add value to your organization.\n\n`;
            letter += `Sincerely,\n${name}`;

            return letter;
        }

        // ===================================================================
        //  RUN ANALYSIS
        // ===================================================================
        function runAnalysis() {
            const jobText = jobDescription.value.trim();
            if (!jobText) {
                showToast('Please paste a job description first.', 'fa-exclamation-triangle');
                return;
            }

            collectProfileFromUI();

            const p = state.profile;
            const allSkills = [...(p.skills || []), ...(p.tools || [])];
            if (allSkills.length === 0) {
                showToast('Add some skills and tools to your profile first!', 'fa-exclamation-triangle');
                return;
            }

            const result = analyzeMatch(jobText);
            state.lastAnalysis = { jobText, result, date: new Date().toISOString() };
            saveState();

            matchResults.classList.remove('hidden');
            coverLetterSection.classList.remove('hidden');

            const score = result.overall;
            const level = getMatchLevel(score);
            scoreCircle.textContent = score + '%';
            scoreCircle.className = 'score-circle ' + level;

            const total = result.totalSkills;
            const matched = result.matchedSkillsCount;
            skillsMatchedEl.textContent = `${matched} / ${total}`;
            toolsMatchedEl.textContent = `${result.toolResult.matched.length} / ${result.toolResult.matched.length + result.toolResult.missing.length}`;
            experienceFit.textContent = result.expFit + '%';
            overallMatch.textContent = getMatchLabel(score) + ` (${score}%)`;

            renderMatchTags(matchedSkillsContainer, result.skillResult.matched, 'match');
            renderMatchTags(missingSkillsContainer, result.skillResult.missing, 'mismatch');
            renderMatchTags(matchedToolsContainer, result.toolResult.matched, 'match');
            renderMatchTags(missingToolsContainer, result.toolResult.missing, 'mismatch');

            matchDateBadge.textContent = 'Analyzed ' + formatDateFull(new Date());

            const letter = generateCoverLetter(jobText, result);
            coverLetterBox.textContent = letter;

            showToast(`Match score: ${score}% — ${getMatchLabel(score)}`, 'fa-chart-line');
        }

        function renderMatchTags(container, items, cls) {
            if (!items || items.length === 0) {
                container.innerHTML = `<span class="text-muted text-sm">None</span>`;
                return;
            }
            container.innerHTML = items.map(item => `<span class="tag ${cls}">${escapeHtml(item)}</span>`).join('');
        }

        // ===================================================================
        //  SAVE JOB TO HISTORY
        // ===================================================================
        function saveCurrentJobToHistory(status = 'not-applied') {
            if (!state.lastAnalysis) {
                showToast('No analysis to save. Run a match first.', 'fa-exclamation-triangle');
                return;
            }
            const { jobText, result, date } = state.lastAnalysis;

            let title = 'Untitled Job';
            const titleMatch = jobText.match(/(?:title|position|role|job title):\s*([^\n.]+)/i);
            if (titleMatch) title = titleMatch[1].trim();
            else {
                const firstLine = jobText.split('\n').find(l => l.trim().length > 10);
                if (firstLine) title = firstLine.trim().slice(0, 50);
            }

            let company = 'Unknown Company';
            const companyMatch = jobText.match(/(?:company|organization|firm|@):\s*([^\n.]+)/i);
            if (companyMatch) company = companyMatch[1].trim();

            const entry = {
                id: generateId(),
                jobTitle: title,
                company: company,
                description: jobText.slice(0, 500) + (jobText.length > 500 ? '...' : ''),
                matchScore: result.overall,
                skillsMatched: result.matchedSkillsCount,
                toolsMatched: result.toolResult.matched.length,
                coverLetter: coverLetterBox.textContent,
                status: status,
                date: date || new Date().toISOString(),
            };

            const existing = state.history.find(h => h.description === entry.description);
            if (existing) {
                Object.assign(existing, entry);
                showToast('Job updated in history.', 'fa-sync');
            } else {
                state.history.unshift(entry);
                showToast(`Saved "${title}" to history.`, 'fa-save');
            }

            saveState();
            renderHistory();
        }

        // ===================================================================
        //  RENDER: HISTORY
        // ===================================================================
        function renderHistory() {
            const history = state.history || [];
            if (history.length === 0) {
                historyContainer.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>No jobs analyzed yet. Go to the <strong>Matcher</strong> tab and analyze a job to get started.</p>
                    </div>
                `;
                return;
            }

            let html = `
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Job Title</th>
                                <th>Company</th>
                                <th>Match</th>
                                <th>Skills</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            for (const job of history) {
                const statusClass = job.status === 'applied' ? 'applied' :
                    job.status === 'rejected' ? 'rejected' :
                    job.status === 'interview' ? 'interview' : 'not-applied';
                const statusLabel = job.status === 'applied' ? 'Applied' :
                    job.status === 'rejected' ? 'Rejected' :
                    job.status === 'interview' ? 'Interview' : 'Not Applied';

                html += `
                    <tr>
                        <td class="job-title-cell" title="${escapeHtml(job.jobTitle)}">${escapeHtml(job.jobTitle)}</td>
                        <td>${escapeHtml(job.company)}</td>
                        <td><strong>${job.matchScore}%</strong></td>
                        <td>${job.skillsMatched || 0}</td>
                        <td><span class="status-badge ${statusClass}">${statusLabel}</span></td>
                        <td style="font-size:12px;color:var(--text-muted)">${formatDate(job.date)}</td>
                        <td class="job-actions-cell">
                            <button class="btn btn-secondary btn-sm view-job-btn" data-id="${job.id}"><i class="fas fa-eye"></i></button>
                            <button class="btn btn-secondary btn-sm delete-job-btn" data-id="${job.id}"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            }

            html += `</tbody></table></div>`;
            historyContainer.innerHTML = html;

            historyContainer.querySelectorAll('.view-job-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.id;
                    const job = state.history.find(h => h.id === id);
                    if (job) {
                        showToast(`📄 ${job.jobTitle} — ${job.matchScore}% match`, 'fa-file-alt');
                        jobDescription.value = job.description;
                        switchPage('matcher');
                        setTimeout(() => runAnalysis(), 300);
                    }
                });
            });

            historyContainer.querySelectorAll('.delete-job-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.id;
                    if (confirm('Delete this job from history?')) {
                        state.history = state.history.filter(h => h.id !== id);
                        saveState();
                        renderHistory();
                        showToast('Job removed from history.', 'fa-trash');
                    }
                });
            });
        }

        // ===================================================================
        //  NAVIGATION
        // ===================================================================
        function switchPage(pageId) {
            Object.keys(pages).forEach(key => {
                pages[key].classList.remove('active');
            });
            pages[pageId].classList.add('active');

            navBtns.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.page === pageId);
            });

            if (pageId === 'history') renderHistory();
            if (pageId === 'profile') renderProfile();
        }

        // ===================================================================
        //  EXPORT / IMPORT
        // ===================================================================
        function exportData() {
            const data = JSON.stringify(state, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `monica_jobmatch_${new Date().toISOString().slice(0,10)}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Data exported successfully!', 'fa-file-export');
        }

        function importData(file) {
            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.profile && imported.history !== undefined) {
                        state = imported;
                        saveState();
                        renderProfile();
                        renderHistory();
                        showToast('Data imported successfully!', 'fa-file-import');
                    } else {
                        showToast('Invalid data format.', 'fa-exclamation-triangle');
                    }
                } catch (err) {
                    showToast('Error importing data: ' + err.message, 'fa-exclamation-triangle');
                }
            };
            reader.readAsText(file);
        }

        // ===================================================================
        //  INIT
        // ===================================================================
        function init() {
            const loaded = loadState();
            if (!loaded) {
                resetToDefaults();
            }

            renderProfile();
            renderHistory();

            // -------- NAVIGATION --------
            navBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    switchPage(btn.dataset.page);
                });
            });

            // -------- PROFILE EVENTS --------
            [profileName, profileTitle, profileSummary, profileExperience, profileEducation].forEach(el => {
                el.addEventListener('input', () => {
                    collectProfileFromUI();
                });
            });

            addSkillBtn.addEventListener('click', () => {
                const val = skillInput.value.trim();
                if (val && !state.profile.skills.includes(val)) {
                    state.profile.skills.push(val);
                    saveState();
                    renderProfile();
                    skillInput.value = '';
                    showToast(`Added skill: ${val}`, 'fa-plus-circle');
                } else if (state.profile.skills.includes(val)) {
                    showToast('Skill already exists.', 'fa-info-circle');
                }
            });
            skillInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') addSkillBtn.click(); });

            addToolBtn.addEventListener('click', () => {
                const val = toolInput.value.trim();
                if (val && !state.profile.tools.includes(val)) {
                    state.profile.tools.push(val);
                    saveState();
                    renderProfile();
                    toolInput.value = '';
                    showToast(`Added tool: ${val}`, 'fa-plus-circle');
                } else if (state.profile.tools.includes(val)) {
                    showToast('Tool already exists.', 'fa-info-circle');
                }
            });
            toolInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') addToolBtn.click(); });

            // -------- MATCHER EVENTS --------
            analyzeBtn.addEventListener('click', runAnalysis);

            clearJobBtn.addEventListener('click', () => {
                jobDescription.value = '';
                matchResults.classList.add('hidden');
                coverLetterSection.classList.add('hidden');
                state.lastAnalysis = null;
                saveState();
                showToast('Cleared job description.', 'fa-undo');
            });

            copyLetterBtn.addEventListener('click', () => {
                const text = coverLetterBox.textContent;
                if (text && !text.includes('tailored cover letter will appear here')) {
                    navigator.clipboard.writeText(text).then(() => {
                        showToast('Cover letter copied to clipboard!', 'fa-copy');
                    }).catch(() => {
                        const area = document.createElement('textarea');
                        area.value = text;
                        document.body.appendChild(area);
                        area.select();
                        document.execCommand('copy');
                        area.remove();
                        showToast('Cover letter copied!', 'fa-copy');
                    });
                } else {
                    showToast('Generate a cover letter first.', 'fa-info-circle');
                }
            });

            saveJobBtn.addEventListener('click', () => saveCurrentJobToHistory('not-applied'));

            regenerateLetterBtn.addEventListener('click', () => {
                if (state.lastAnalysis) {
                    const letter = generateCoverLetter(state.lastAnalysis.jobText, state.lastAnalysis.result);
                    coverLetterBox.textContent = letter;
                    showToast('Cover letter regenerated.', 'fa-sync');
                } else {
                    showToast('Run an analysis first.', 'fa-info-circle');
                }
            });

            markAppliedBtn.addEventListener('click', () => {
                if (state.lastAnalysis) {
                    saveCurrentJobToHistory('applied');
                    renderHistory();
                } else {
                    showToast('Run an analysis first.', 'fa-info-circle');
                }
            });

            markNotAppliedBtn.addEventListener('click', () => {
                if (state.lastAnalysis) {
                    saveCurrentJobToHistory('not-applied');
                    renderHistory();
                } else {
                    showToast('Run an analysis first.', 'fa-info-circle');
                }
            });

            // -------- HISTORY EVENTS --------
            clearHistoryBtn.addEventListener('click', () => {
                if (state.history.length === 0) {
                    showToast('History is already empty.', 'fa-info-circle');
                    return;
                }
                if (confirm('Delete all job history?')) {
                    state.history = [];
                    saveState();
                    renderHistory();
                    showToast('History cleared.', 'fa-trash');
                }
            });

            // -------- EXPORT / IMPORT --------
            exportDataBtn.addEventListener('click', exportData);

            importDataBtn.addEventListener('click', () => {
                importFileInput.click();
            });

            importFileInput.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    importData(file);
                }
                importFileInput.value = '';
            });

            // -------- KEYBOARD SHORTCUT: Ctrl+Enter --------
            jobDescription.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'Enter') {
                    e.preventDefault();
                    analyzeBtn.click();
                }
            });

            // -------- AUTO-SAVE PROFILE --------
            setInterval(collectProfileFromUI, 2000);

            showToast('🚀 Monica\'s Job Match ready — paste a job and hit Analyze!', 'fa-rocket');
        }

        // ===================================================================
        //  START
        // ===================================================================
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
